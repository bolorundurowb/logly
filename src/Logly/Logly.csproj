<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>3.0.1</Version>
        <Authors>Winner-Timothy Bolorunduro</Authors>
        <Description>A library to log request and response data in the format of morgan for NodeJS</Description>
        <PackageId>Logly</PackageId>
        <PackageTags>log,logly,logger,asp.net,core,morgan</PackageTags>
        <PackageProjectUrl>https://github.com/bolorundurowb/logly/blob/master/README.md</PackageProjectUrl>
        <RepositoryUrl>https://github.com/bolorundurowb/logly</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <TargetFrameworks>net5.0;net6.0;net7.0;net8.0;net9.0;netcoreapp3.1;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageReleaseNotes>
            - update dependencies
            - add newer .NET version support
            - remove older targets like ASP.NET 1 and 2
        </PackageReleaseNotes>
        <Copyright>©2020-2026, Winner-Timothy Bolorunduro. All Rights reserved.</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AssemblyName>Logly</AssemblyName>
        <RootNamespace>Logly</RootNamespace>
        <Title>Logly</Title>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.10" />
    </ItemGroup>
</Project>